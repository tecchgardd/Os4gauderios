# Copie para .env.local e preencha.

# Postgres do Neon (painel do Neon → Connect → "Pooled connection")
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Login (Better Auth). Gere a chave com:  npx @better-auth/cli secret
BETTER_AUTH_SECRET=""
# endereço do site (em produção: https://os4gauderios.com.br)
BETTER_AUTH_URL="http://localhost:3000"

# Cloudinary (painel do Cloudinary → Settings → API Keys)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# pasta onde as fotos e vídeos do painel ficam no Cloudinary
CLOUDINARY_FOLDER="os4gauderios"
